<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- 6 x 8 m patrolling arena with color targets only. -->
  <world name="random_world">
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.82 0.88 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <physics name="fast" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>400</real_time_update_rate>
      <real_time_factor>2.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics">
      <include_entity_names>true</include_entity_names>
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-contact-system.so" name="ignition::gazebo::systems::Contact">
      <topic>/world/random_world/physics/contacts</topic>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.5 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range><linear>0.1</linear><constant>0.9</constant><quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 8 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 8 0.02</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall inner faces lie at X = +/-3 m and Y = +/-4 m. -->
    <model name="north_wall">
      <static>true</static><pose>0 4.125 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.5 0.25 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.5 0.25 2</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -4.125 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.5 0.25 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.5 0.25 2</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>3.125 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 8 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 8 2</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-3.125 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 8 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 8 2</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Patrolling targets, also used as delivery destinations. -->
    <model name="red_box"><pose>-2 -1.5 0.006 0 0 0.37</pose><static>true</static><link name="link"><visual name="visual"><pose>0 0 0.75 0 0 0</pose><visibility_flags>4</visibility_flags><geometry><cylinder><radius>0.075</radius><length>1.5</length></cylinder></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material></visual></link></model>
    <model name="green_box"><pose>-1.8 2.6 0.006 0 0 1.12</pose><static>true</static><link name="link"><visual name="visual"><pose>0 0 0.75 0 0 0</pose><visibility_flags>4</visibility_flags><geometry><cylinder><radius>0.075</radius><length>1.5</length></cylinder></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 1 0 1</emissive></material></visual></link></model>
    <model name="blue_box"><pose>2.4 -2.7 0.006 0 0 2.31</pose><static>true</static><link name="link"><visual name="visual"><pose>0 0 0.75 0 0 0</pose><visibility_flags>4</visibility_flags><geometry><cylinder><radius>0.075</radius><length>1.5</length></cylinder></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse><emissive>0 0 1 1</emissive></material></visual></link></model>

    <model name="top_view_camera">
      <static>true</static>
      <pose>0 0 12 0 1.57079632679 0</pose>
      <link name="link">
        <sensor name="top_view_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>top_view_camera/image</topic>
          <camera>
            <horizontal_fov>1.35</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
