<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Canonical arena plus only the three patrolling targets. -->
  <world name="random_world">
    <physics name="1ms" type="ignored"><max_step_size>0.01</max_step_size><real_time_update_rate>400</real_time_update_rate></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"><include_entity_names>true</include_entity_names></plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-contact-system.so" name="ignition::gazebo::systems::Contact"><topic>/world/random_world/physics/contacts</topic></plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><intensity>1</intensity><direction>-0.5 0.5 -1</direction><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>10</range><linear>1</linear><constant>1</constant><quadratic>0</quadratic></attenuation></light>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry><surface><friction><ode/></friction></surface></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name="north_wall"><pose>0 5.25 1 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><box><size>10 0.5 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.5 2</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name="south_wall"><pose>0 -5.25 1 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><box><size>10 0.5 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.5 2</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name="east_wall"><pose>5.25 0 1 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><box><size>0.5 10 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 10 2</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name="west_wall"><pose>-5.25 0 1 0 0 0</pose><static>true</static><link name="link"><collision name="collision"><geometry><box><size>0.5 10 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 10 2</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name="red_box"><pose>-3.0 -1.5 0.006 0 0 0.37</pose><static>true</static><link name="link"><visual name="visual"><pose>0 0 0.75 0 0 0</pose><visibility_flags>4</visibility_flags><geometry><cylinder><radius>0.075</radius><length>1.5</length></cylinder></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material></visual></link></model>
    <model name="green_box"><pose>-1.8 2.6 0.006 0 0 1.12</pose><static>true</static><link name="link"><visual name="visual"><pose>0 0 0.75 0 0 0</pose><visibility_flags>4</visibility_flags><geometry><cylinder><radius>0.075</radius><length>1.5</length></cylinder></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><emissive>0 1 0 1</emissive></material></visual></link></model>
    <model name="blue_box"><pose>2.4 -2.7 0.006 0 0 2.31</pose><static>true</static><link name="link"><visual name="visual"><pose>0 0 0.75 0 0 0</pose><visibility_flags>4</visibility_flags><geometry><cylinder><radius>0.075</radius><length>1.5</length></cylinder></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse><emissive>0 0 1 1</emissive></material></visual></link></model>
    <model name="top_view_camera"><static>true</static><pose>0 0 12 0 1.57079632679 0</pose><link name="link"><sensor name="top_view_camera" type="camera"><always_on>true</always_on><update_rate>30</update_rate><topic>top_view_camera/image</topic><camera><horizontal_fov>1.35</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip></camera></sensor></link></model>
  </world>
</sdf>
