{
  "automata": [
    {
      "type": "specification",
      "name": "red_green_blue_patrol_specification",
      "states": [
        "red_search",
        "red_approach",
        "green_search",
        "green_approach",
        "blue_search",
        "blue_approach",
        "patrol_complete"
      ],
      "initial_state": "red_search",
      "marked_states": [
        "patrol_complete"
      ],
      "events": [
        "search_color",
        "approach_color",
        "red_visible",
        "red_not_visible",
        "red_reached",
        "green_visible",
        "green_not_visible",
        "green_reached",
        "blue_visible",
        "blue_not_visible",
        "blue_reached"
      ],
      "transitions": [
        "(\"red_search\", \"search_color\", \"red_search\")",
        "(\"red_search\", \"red_visible\", \"red_approach\")",
        "(\"red_search\", \"red_reached\", \"green_search\")",
        "(\"red_approach\", \"approach_color\", \"red_approach\")",
        "(\"red_approach\", \"red_not_visible\", \"red_search\")",
        "(\"red_approach\", \"red_reached\", \"green_search\")",
        "(\"green_search\", \"search_color\", \"green_search\")",
        "(\"green_search\", \"green_visible\", \"green_approach\")",
        "(\"green_search\", \"green_reached\", \"blue_search\")",
        "(\"green_approach\", \"approach_color\", \"green_approach\")",
        "(\"green_approach\", \"green_not_visible\", \"green_search\")",
        "(\"green_approach\", \"green_reached\", \"blue_search\")",
        "(\"blue_search\", \"search_color\", \"blue_search\")",
        "(\"blue_search\", \"blue_visible\", \"blue_approach\")",
        "(\"blue_search\", \"blue_reached\", \"patrol_complete\")",
        "(\"blue_approach\", \"approach_color\", \"blue_approach\")",
        "(\"blue_approach\", \"blue_not_visible\", \"blue_search\")",
        "(\"blue_approach\", \"blue_reached\", \"patrol_complete\")"
      ]
    }
  ],
  "explanation": {
    "event_selection": "The specification uses only the task-level controllable events search_color and approach_color, together with the visibility, loss-of-visibility, and reached observations for red, green, and blue. Low-level movement and obstacle events are omitted because obstacle avoidance is already enforced by collision_avoidance.",
    "transition_design": "The states enforce red, then green, then blue, with distinct search and approach phases for each zone. A matching visible observation enters the approach phase, a matching not_visible observation returns to the search phase, and a matching reached observation advances from either phase. Only search_color is enabled in search states and only approach_color is enabled in approach states. Reaching blue enters the sole marked state patrol_complete, where mission motion is disabled.",
    "feedback_response": "No previous-run feedback was supplied."
  }
}
